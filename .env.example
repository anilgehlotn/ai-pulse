# Settings for docker compose. Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# Signs login tokens. Required: the backend refuses to start in production without it.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "mock" (default) uses canned AI replies. See docker-compose.yml for running against Ollama.
AI_MODE=mock

# These are the only two settings docker-compose.yml reads from this file. It sets APP_ENV, DATABASE_URL and
# CORS_ORIGINS itself; every backend setting is described in backend/.env.example, frontend ones in frontend/.env.example.
