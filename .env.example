# Settings for docker compose. Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# Signs login tokens. Required: the backend refuses to start in production without it.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "mock" (default) uses canned AI replies. See docker-compose.yml for running against Ollama.
AI_MODE=mock
