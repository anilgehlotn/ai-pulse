# Copy to frontend/.env.local to change it. Read at build time by Vite.
# Where the browser finds the backend API (default http://localhost:8000).
VITE_API_URL=http://localhost:8000
# Show the Demo accounts box on the login page in a production build (it always shows in development).
# Set on the public demo only; never on a real client deployment.
VITE_SHOW_DEMO_ACCOUNTS=false
