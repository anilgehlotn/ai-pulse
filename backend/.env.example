# Copy to .env and fill in real values. Never commit .env.

# Environment name: dev, test or production. Anything except dev/test requires SECRET_KEY.
APP_ENV=dev
# Signs login tokens. Use a long random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=change-me
# bcrypt cost factor for password hashes (default 12). Tests use 4.
BCRYPT_ROUNDS=12
# Smallest group of respondents leadership may see results for (default 5, at least 3).
MIN_GROUP_SIZE=5
# Login rate limits. After LOGIN_MAX_FAILURES failed logins for one email within LOGIN_WINDOW_SECONDS,
# that email gets 429 until the window passes (defaults 5 and 900). Whole numbers of at least 1.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
# Login attempts allowed from one client IP per minute, successful or not (default 30).
LOGIN_MAX_PER_IP=30
# SQLAlchemy database URL.
DATABASE_URL=sqlite:///./aipulse.db
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# "mock" uses canned answers from data/mock_ai_responses.json, "live" calls the LLM below.
AI_MODE=mock
# OpenAI-compatible chat completions URL (live mode only).
LLM_API_URL=
# API key for the LLM endpoint (live mode only).
LLM_API_KEY=
# Model name sent to the LLM endpoint (live mode only).
LLM_MODEL=
# true = send response_format {"type": "json_object"}. Only if the provider supports it.
LLM_JSON_MODE=false
# Port start.sh serves the API on (default 8000). Hosting platforms such as Render set it; not read by the app itself.
# PORT=8000
